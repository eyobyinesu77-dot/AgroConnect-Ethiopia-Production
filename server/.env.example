NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/agroconnect?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Must be a Gmail App Password (myaccount.google.com/apppasswords),
# NOT your normal Gmail account password. Gmail rejects the account
# password for SMTP and Nodemailer will fail to authenticate.
SMTP_PASS=your_app_password
# HOSTING NOTE: Render free web services block outbound SMTP ports 25/465/587,
# so Gmail SMTP cannot work from them whatever the credentials are (needs a paid
# instance, or an HTTPS mail API instead). Check from the host: npm run verify:email

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_PHONE=+251900000000

TWO_FACTOR_APP_NAME=AgroConnect

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Used for two things: (1) CORS — which origins the API accepts requests
# from, and (2) the links inside password-reset/verification emails.
# Either or both may be set; set both to the same value for clarity.
# Local development (this default):
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Production (Render): set BOTH of these to the deployed Vercel URL —
# FRONTEND_URL=https://agro-connect-ethiopia-production.vercel.app
# CLIENT_URL=https://agro-connect-ethiopia-production.vercel.app
# Do NOT leave these pointing at localhost in production: reset/verification
# emails would link to a URL only reachable on the developer's own machine.
# With NODE_ENV=production the server now REFUSES to send reset/verification
# emails (and logs why) unless CLIENT_URL or FRONTEND_URL is an absolute,
# non-localhost http(s) URL. For local testing use NODE_ENV=development.

RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Optional. If any of the three below are left unset, image uploads
# (crop photos, loan crop-type photos) fall back to local disk storage
# under server/uploads instead of failing with a Cloudinary API-key error.
# Get real values from https://cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. If unset, the weather endpoint returns simulated data instead
# of failing. Get a free key from https://openweathermap.org/api.
WEATHER_API_KEY=

# Optional. Chapa payment gateway (https://dashboard.chapa.co).
# If unset, Chapa checkout is simulated as Success for local development only.
CHAPA_SECRET_KEY=
CHAPA_CALLBACK_URL=
